# ==============================================================================
# Environment Configuration Template for RAG Chatbot
# Copy this file to .env and fill in the required credentials.
# ==============================================================================

# Qdrant Vector Database (Cloud or Local instance)
# URL of your Qdrant cluster (e.g., https://<your-cluster-id>.<region>.gcp.cloud.qdrant.io:6333)
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
# API Key for authenticating with Qdrant Cloud
QDRANT_API_KEY=your_qdrant_api_key_here

# Groq API Key (Primary LLM generation: llama-3.3-70b-versatile)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (Used for embeddings like gemini-embedding-001 and fallback generation)
GEMINI_API_KEY=your_gemini_api_key_here
# Embedding model name (defaults to models/gemini-embedding-001)
EMBEDDING_MODEL=models/gemini-embedding-001

# LangSmith Observability & Tracing
# Enable tracing in LangChain/LangGraph
LANGCHAIN_TRACING_V2=true
# LangSmith API key for capturing runs and evaluations
LANGCHAIN_API_KEY=lsv2_pt_your_langchain_api_key_here
# Project name under which traces will be grouped
LANGCHAIN_PROJECT=rag-assessment

# Chainlit Authentication & Persistence
# Required for Chainlit session cookie signing and multi-session left sidebar history
CHAINLIT_AUTH_SECRET=generate_a_random_32_byte_hex_string_here
# SQLite chat history database path
CHAT_DB_PATH=chat_history.db
